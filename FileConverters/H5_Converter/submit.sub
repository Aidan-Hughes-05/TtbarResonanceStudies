# ================
# HTCondor submit file
# ================

# Executable script
executable = run.sh

# Standard output/error/log
output = ttbar2_job.out
error  = ttbar2_job.err
log    = ttbar2_job.log

# Request resources
request_memory = 32000
request_cpus   = 8
request_disk   = 4GB

# Transfer the Python script if not on shared FS
# (Uncomment if needed)
transfer_input_files = Ttbar_Sets.py,Common.py,setup.sh
# should_transfer_files = YES
# when_to_transfer_output = ON_EXIT
getenv = True
stream_output = True
stream_error = True

# Run in the current directory
initialdir = .

# Queue a single job
queue