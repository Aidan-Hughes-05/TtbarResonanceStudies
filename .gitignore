# LxPlus
.asetup.save

# Do not store log files
Generate/log_files/
!Generate/log_files/.gitkeep

# Do not store LHE / ROOT / H5 files
*.lhe
*.root
*.h5

# Ignore python bytecode
*.pyc
__pycache__/
py.py
*ipynb_checkpoints/

# Ignore C++ build/install directories
build/
install/

# Ignore VS code
.vscode/

# Ignore environment files
.env