executable = executable.sh
getenv = true

# need to start with 1 because we use this to set the seed
plusone = $(Process) + 1
ProcessPlusOne = $INT(plusone,%d)

request_memory = 16GB
request_cpus = 8

log_dir = /home/dbaronmo/SBI_Ttbar/MCJobLogs/

log = $(log_dir)/ttbar_resonance_$(ProcessPlusOne).log
output = $(log_dir)/ttbar_resonance_$(ProcessPlusOne).out
error = $(log_dir)/ttbar_resonance_$(ProcessPlusOne).err
arguments = $(ProcessPlusOne) $(ARGS)

transfer_input_files = executable.sh

should_transfer_files = Yes
when_to_transfer_output = ON_EXIT

queue 20